# Supabase PostgreSQL (server-only — the browser never talks to Supabase)
DATABASE_URL=

# 4Seas SMTP
SMTP_HOST=mail.4seas.xyz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=residency@4seas.xyz
SMTP_PASSWORD=
EMAIL_FROM="4Seas Residency <residency@4seas.xyz>"
EMAIL_REPLY_TO=residency@4seas.xyz

# Inbound reply sync (defaults to the SMTP host/account when omitted)
IMAP_HOST=mail.4seas.xyz
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=residency@4seas.xyz
IMAP_PASSWORD=

# Admin (single shared long password, >=32 random chars)
ADMIN_PASSWORD=
# Cookie signing secret (>=32 random chars)
SESSION_SECRET=

# Salt for hashing submitter IPs (rate limiting; raw IPs are never stored)
IP_HASH_SALT=
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
